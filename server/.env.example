# ------------------------------------------------------------------
# SchemeFit AI backend — environment template
# Copy to `.env` and adjust. NEVER commit a real .env.
# ------------------------------------------------------------------

# Runtime
NODE_ENV=development
PORT=4000
# Browser origin(s) of the SPA, matched EXACTLY (scheme + host + port).
# One value, or a comma-separated allow-list (prod + Vercel preview URLs):
#   https://schemefit.vercel.app,https://schemefit-git-main-you.vercel.app
CLIENT_ORIGIN=http://localhost:5173

# Database
MONGO_URL=mongodb://127.0.0.1:27017/schemefit
# Atlas looks like:
#   mongodb+srv://USER:PASS@cluster0.xxxxx.mongodb.net/schemefit?retryWrites=true&w=majority&appName=schemefit
# Used only by the test runner:
MONGO_URL_TEST=mongodb://127.0.0.1:27017/schemefit_test

# Sessions / cookies
# 32+ random chars. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=replace-with-a-long-random-string-min-32-chars
SESSION_TTL_HOURS=168
COOKIE_DOMAIN=
# Set true only when served over HTTPS. Auto-true when NODE_ENV=production or COOKIE_SAMESITE=none.
COOKIE_SECURE=false
# lax  → SPA and API share a site (dev proxy, or same domain in prod)
# none → SPA and API are on DIFFERENT sites (e.g. web on Vercel, API on Render).
#        Requires HTTPS on both. This is the usual production value for a split deploy.
COOKIE_SAMESITE=lax

# Auth rate limiting
LOGIN_RATE_MAX=5
LOGIN_RATE_WINDOW_MINUTES=15

# File storage — driver = local | s3
STORAGE_DRIVER=local
# local driver: absolute or relative dir OUTSIDE any public/web root.
# On an ephemeral host (Render free) this does not survive restarts — use s3 for durability.
STORAGE_LOCAL_DIR=./var/uploads
UPLOAD_MAX_BYTES=10485760

# S3-compatible storage (only read when STORAGE_DRIVER=s3).
# Works with AWS S3 and S3-compatible services. Cloudflare R2 example:
#   S3_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
#   S3_REGION=auto
#   S3_FORCE_PATH_STYLE=true
S3_BUCKET=
S3_REGION=ap-south-1
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true

# Seed accounts. In production the seed refuses to run unless SEED_ALLOW_PROD=true.
SEED_ADMIN_EMAIL=admin@schemefit.dev
SEED_ADMIN_PASSWORD=DevAdmin!2026
# Run the idempotent seed automatically on boot IF the users collection is empty
# (handy for a one-shot demo deploy with no shell access). Leave false locally.
SEED_ON_BOOT=false
SEED_ALLOW_PROD=false
