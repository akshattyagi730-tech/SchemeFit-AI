# ------------------------------------------------------------------
# SchemeFit AI frontend (Vite) — environment template
# Copy to `.env.local` for local overrides. Vars are read at BUILD time.
# ------------------------------------------------------------------

# Leave UNSET for local dev (Vite proxies /api → http://localhost:4000) and for
# same-origin production deploys behind a reverse proxy.
#
# Set to the API origin for a split deploy (web and API on different hosts):
#   VITE_API_BASE_URL=https://schemefit-api.onrender.com
# The client appends /api/v1 itself.
# VITE_API_BASE_URL=

# Dev-only: point the Vite proxy at a non-default backend.
# VITE_API_PROXY=http://localhost:4000
